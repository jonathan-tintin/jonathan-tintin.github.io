<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Jonathan — TPM & Aspiring PM</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cream: #FAF8F3;
      --warm-white: #FFFEF9;
      --sand: #EDE8DF;
      --clay: #C8B99A;
      --terra: #9B6F4B;
      --bark: #5C3D24;
      --ink: #2A1F14;
      --sage: #6B7B5E;
      --muted: #8C7D6D;
      --accent: #B85C38;
      --accent-light: #F5EDE8;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
      color: var(--ink);
      line-height: 1.7;
      font-size: 16px;
    }

    /* NAV */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.1rem 3rem;
      background: rgba(250, 248, 243, 0.92);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--sand);
    }

    .nav-name {
      font-family: 'Lora', serif;
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--bark);
      letter-spacing: -0.01em;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }

    .nav-links a {
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--muted);
      text-decoration: none;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      transition: color 0.2s;
    }

    .nav-links a:hover { color: var(--accent); }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 7rem 3rem 5rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .hero-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: center;
      width: 100%;
    }

    .hero-tag {
      display: inline-block;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      background: var(--accent-light);
      padding: 0.3rem 0.8rem;
      border-radius: 2rem;
      margin-bottom: 1.5rem;
    }

    .hero h1 {
      font-family: 'Lora', serif;
      font-size: clamp(2.4rem, 4vw, 3.4rem);
      font-weight: 600;
      line-height: 1.15;
      color: var(--bark);
      margin-bottom: 1.5rem;
      letter-spacing: -0.02em;
    }

    .hero h1 em {
      font-style: italic;
      color: var(--terra);
    }

    .hero-sub {
      font-size: 1.05rem;
      color: var(--muted);
      line-height: 1.75;
      margin-bottom: 2.5rem;
      max-width: 420px;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 0.75rem 1.6rem;
      border-radius: 2rem;
      font-size: 0.9rem;
      font-weight: 500;
      text-decoration: none;
      transition: all 0.2s;
      cursor: pointer;
    }

    .btn-primary {
      background: var(--bark);
      color: var(--cream);
      border: 2px solid var(--bark);
    }

    .btn-primary:hover {
      background: var(--accent);
      border-color: var(--accent);
    }

    .btn-outline {
      background: transparent;
      color: var(--bark);
      border: 2px solid var(--clay);
    }

    .btn-outline:hover {
      border-color: var(--bark);
    }

    /* Hero visual: initials card */
    .hero-visual {
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }

    .avatar-card {
      width: 280px;
      height: 340px;
      background: var(--warm-white);
      border: 1px solid var(--sand);
      border-radius: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      position: relative;
      box-shadow: 8px 12px 40px rgba(92, 61, 36, 0.08);
    }

    .avatar-initials {
      width: 90px;
      height: 90px;
      background: var(--sand);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Lora', serif;
      font-size: 2rem;
      font-weight: 600;
      color: var(--bark);
    }

    .avatar-name {
      font-family: 'Lora', serif;
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--bark);
    }

    .avatar-role {
      font-size: 0.82rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .avatar-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      justify-content: center;
      padding: 0 1.5rem;
    }

    .avatar-tag {
      font-size: 0.72rem;
      font-weight: 500;
      padding: 0.25rem 0.6rem;
      background: var(--cream);
      border: 1px solid var(--sand);
      border-radius: 1rem;
      color: var(--muted);
    }

    .floating-badge {
      position: absolute;
      background: var(--warm-white);
      border: 1px solid var(--sand);
      border-radius: 12px;
      padding: 0.6rem 0.9rem;
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--bark);
      white-space: nowrap;
      box-shadow: 4px 6px 20px rgba(92, 61, 36, 0.08);
    }

    .badge-tl { top: -20px; left: -40px; }
    .badge-br { bottom: -16px; right: -36px; }

    /* SECTIONS */
    section {
      padding: 6rem 3rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .section-label {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.6rem;
    }

    .section-title {
      font-family: 'Lora', serif;
      font-size: clamp(1.8rem, 3vw, 2.4rem);
      font-weight: 600;
      color: var(--bark);
      line-height: 1.2;
      margin-bottom: 1rem;
      letter-spacing: -0.02em;
    }

    .section-divider {
      border: none;
      border-top: 1px solid var(--sand);
      margin: 0 3rem;
    }

    /* ABOUT */
    .about-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 5rem;
      align-items: start;
      margin-top: 3rem;
    }

    .about-text p {
      color: var(--muted);
      margin-bottom: 1.2rem;
      line-height: 1.8;
    }

    .about-text p strong {
      color: var(--bark);
      font-weight: 600;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .stat-card {
      background: var(--warm-white);
      border: 1px solid var(--sand);
      border-radius: 16px;
      padding: 1.3rem 1.2rem;
    }

    .stat-number {
      font-family: 'Lora', serif;
      font-size: 1.8rem;
      font-weight: 600;
      color: var(--bark);
      line-height: 1;
      margin-bottom: 0.3rem;
    }

    .stat-label {
      font-size: 0.78rem;
      color: var(--muted);
      line-height: 1.3;
    }

    /* EXPERIENCE */
    .timeline {
      margin-top: 3rem;
      position: relative;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 0;
      top: 8px;
      bottom: 0;
      width: 1px;
      background: var(--sand);
    }

    .timeline-item {
      padding-left: 2.5rem;
      margin-bottom: 3rem;
      position: relative;
    }

    .timeline-dot {
      position: absolute;
      left: -5px;
      top: 7px;
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: var(--clay);
      border: 2px solid var(--cream);
    }

    .timeline-item.active .timeline-dot {
      background: var(--accent);
    }

    .timeline-meta {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 0.4rem;
      flex-wrap: wrap;
    }

    .timeline-date {
      font-size: 0.78rem;
      color: var(--muted);
      font-weight: 500;
      letter-spacing: 0.03em;
    }

    .timeline-current {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--accent);
      background: var(--accent-light);
      padding: 0.15rem 0.55rem;
      border-radius: 1rem;
    }

    .timeline-role {
      font-family: 'Lora', serif;
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--bark);
      margin-bottom: 0.15rem;
    }

    .timeline-company {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--terra);
      margin-bottom: 0.7rem;
    }

    .timeline-desc {
      font-size: 0.92rem;
      color: var(--muted);
      line-height: 1.75;
    }

    .timeline-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.8rem;
    }

    .pill {
      font-size: 0.72rem;
      font-weight: 500;
      padding: 0.25rem 0.65rem;
      background: var(--cream);
      border: 1px solid var(--sand);
      border-radius: 1rem;
      color: var(--muted);
    }

    /* SKILLS */
    .skills-bg {
      background: var(--warm-white);
      border-top: 1px solid var(--sand);
      border-bottom: 1px solid var(--sand);
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 3rem;
    }

    .skill-group {
      background: var(--cream);
      border: 1px solid var(--sand);
      border-radius: 16px;
      padding: 1.5rem;
    }

    .skill-group-icon {
      font-size: 1.4rem;
      margin-bottom: 0.8rem;
    }

    .skill-group-title {
      font-family: 'Lora', serif;
      font-size: 1rem;
      font-weight: 600;
      color: var(--bark);
      margin-bottom: 0.8rem;
    }

    .skill-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .skill-list li {
      font-size: 0.85rem;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .skill-list li::before {
      content: '';
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--clay);
      flex-shrink: 0;
    }

    /* PROJECTS */
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
      margin-top: 3rem;
    }

    .project-card {
      background: var(--warm-white);
      border: 1px solid var(--sand);
      border-radius: 18px;
      padding: 1.8rem;
      transition: border-color 0.2s;
    }

    .project-card:hover {
      border-color: var(--clay);
    }

    .project-icon {
      font-size: 1.6rem;
      margin-bottom: 1rem;
    }

    .project-title {
      font-family: 'Lora', serif;
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--bark);
      margin-bottom: 0.5rem;
    }

    .project-desc {
      font-size: 0.88rem;
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 1rem;
    }

    /* EXTRACURRICULARS */
    .extras-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.2rem;
      margin-top: 3rem;
    }

    .extra-card {
      background: var(--warm-white);
      border: 1px solid var(--sand);
      border-radius: 16px;
      padding: 1.4rem 1.3rem;
    }

    .extra-icon {
      font-size: 1.4rem;
      margin-bottom: 0.7rem;
    }

    .extra-title {
      font-weight: 600;
      color: var(--bark);
      font-size: 0.92rem;
      margin-bottom: 0.35rem;
    }

    .extra-desc {
      font-size: 0.82rem;
      color: var(--muted);
      line-height: 1.6;
    }

    /* CONTACT */
    .contact-inner {
      background: var(--warm-white);
      border: 1px solid var(--sand);
      border-radius: 24px;
      padding: 4rem;
      text-align: center;
      margin-top: 3rem;
    }

    .contact-inner p {
      color: var(--muted);
      max-width: 440px;
      margin: 1rem auto 2.5rem;
      font-size: 1rem;
      line-height: 1.7;
    }

    .contact-links {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .contact-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 1.4rem;
      background: var(--cream);
      border: 1px solid var(--sand);
      border-radius: 2rem;
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--bark);
      transition: all 0.2s;
    }

    .contact-link:hover {
      background: var(--sand);
    }

    /* FOOTER */
    footer {
      text-align: center;
      padding: 2.5rem 3rem;
      font-size: 0.82rem;
      color: var(--muted);
      border-top: 1px solid var(--sand);
    }

    /* RESPONSIVE */
    @media (max-width: 768px) {
      nav { padding: 1rem 1.5rem; }
      .nav-links { gap: 1.2rem; }
      .hero { padding: 6rem 1.5rem 3rem; }
      .hero-inner { grid-template-columns: 1fr; gap: 3rem; }
      .hero-visual { display: none; }
      section { padding: 4rem 1.5rem; }
      .section-divider { margin: 0 1.5rem; }
      .about-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .skills-grid { grid-template-columns: 1fr 1fr; }
      .projects-grid { grid-template-columns: 1fr; }
      .extras-grid { grid-template-columns: 1fr 1fr; }
      .contact-inner { padding: 2.5rem 1.5rem; }
    }

    @media (max-width: 480px) {
      .skills-grid { grid-template-columns: 1fr; }
      .extras-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
